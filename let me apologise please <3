<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I'm Sorry 💔</title>

<style>
* { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top, #ffd6e8, #ff9ecb);
  display: flex;
  justify-content: center;
  align-items: center;
}

.card, .note {
  background: #fff;
  padding: 22px;
  border-radius: 18px;
  box-shadow: 0 20px 40px rgba(0,0,0,.2);
  max-width: 380px;
  width: 92%;
  text-align: center;
}

h1 { color: #ff2f92; }

img.main {
  width: 100%;
  border-radius: 12px;
  margin: 12px 0;
}

.btn {
  border: none;
  padding: 12px 18px;
  border-radius: 999px;
  font-weight: 700;
  cursor: pointer;
  margin: 6px;
}

.yes { background: #00b894; color: white; }
.no  { background: #d63031; color: white; }

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.75);
  display: none;
  justify-content: center;
  align-items: center;
}

.modal {
  background: #fff;
  padding: 14px;
  border-radius: 16px;
  max-width: 300px;
  text-align:center;
}

.note { display: none; text-align:left; }

#typedText::after {
  content: "|";
  animation: blink 1s infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* FINAL MESSAGE */
.final-message {
  opacity: 0;
  transform: translateY(20px);
  background: #ffe6f0;
  padding: 14px;
  border-radius: 12px;
  margin-top: 18px;
  font-weight: 600;
  color: #ff2f92;
}

.show-final {
  animation: fadeInUp 1.2s ease forwards, glow 2s infinite alternate;
}

@keyframes fadeInUp {
  to { opacity: 1; transform: translateY(0); }
}

@keyframes glow {
  from { box-shadow: 0 0 10px rgba(255,47,146,0.3); }
  to { box-shadow: 0 0 20px rgba(255,47,146,0.6); }
}

/* FINAL IMAGES */
.image-row {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  opacity: 0;
  transform: scale(0.9);
}

.show-images {
  animation: popIn 1s ease forwards;
}

@keyframes popIn {
  to { opacity: 1; transform: scale(1); }
}

.image-row img {
  width: 50%;
  border-radius: 10px;
}
</style>
</head>

<body>

<!-- HEARTBEAT SOUND -->
<audio id="heartbeat" src="heartbeat.mp3"></audio>

<!-- START -->
<div class="card" id="questionCard">
  <h1>Hey my Maggie 💔</h1>
  <img src="start.jpg" class="main">
  <p>I messed up… and I need to ask you something</p>
  <h2>Will you forgive me? 🥺</h2>

  <button class="btn yes" onclick="onYes()">Yes ❤️</button>
  <button class="btn no" onclick="onNo()">No 😔</button>
</div>

<!-- NO -->
<div id="noPopup" class="overlay">
  <div class="modal">
    <p>Please… just hear me out once 🥺</p>
    <button onclick="closeNo()">Okay</button>
  </div>
</div>

<!-- YES -->
<div id="yesPopup" class="overlay">
  <div class="modal">
    <p>Thank you for giving me a chance ❤️</p>
    <button onclick="goToNote()">Read my apology 💌</button>
  </div>
</div>

<!-- NOTE -->
<div class="note" id="loveNote">
  <h2>To my dear Miyu 💌</h2>

  <p id="typedText"></p>

  <div id="finalMessage" class="final-message">
    I treasure every bit of who you are. 
    I’m incredibly sorry for the way I acted and for causing you pain. 
    Seeing your free spirit is my favorite thing, and I hate that I did anything to dampen it. 
    I’m sorry.
  </div>

  <div id="finalImages" class="image-row">
    <img src="img1.jpg">
    <img src="img2.jpg">
  </div>

  <br>
  <button class="btn yes" onclick="back()">Back</button>
</div>

<script>
function onYes() {
  document.getElementById("yesPopup").style.display = "flex";
}

function onNo() {
  document.getElementById("noPopup").style.display = "flex";
}

function closeNo() {
  document.getElementById("noPopup").style.display = "none";
}

function goToNote() {
  document.getElementById("yesPopup").style.display = "none";
  document.getElementById("questionCard").style.display = "none";
  document.getElementById("loveNote").style.display = "block";
  startTyping();
}

const text = `To my dear Miyu (Maggieee, Mei, my Moonpiee) 💖

I made you fall… and because of me, you got hurt badly.
I know that, and I won’t deny it — I’m the reason it happened.

I carry that guilt with me every moment.

But please believe me…
it was never my intention to hurt you.

I miss your smile, your voice, your light.

I’m deeply, truly sorry… Miyu.

Forever yours,
Your Peanut Butter 🥜❤️`;

let i = 0;

function startTyping() {
  const speed = 35;
  function type() {
    if (i < text.length) {
      document.getElementById("typedText").innerHTML += text.charAt(i);
      i++;
      setTimeout(type, speed);
    } else {
      setTimeout(() => {
        document.getElementById("finalMessage").classList.add("show-final");
        document.getElementById("finalImages").classList.add("show-images");

        // 💓 PLAY HEARTBEAT HERE
        const beat = document.getElementById("heartbeat");
        beat.volume = 0.4;
        beat.play();

      }, 600);
    }
  }
  type();
}

function back() {
  document.getElementById("loveNote").style.display = "none";
  document.getElementById("questionCard").style.display = "block";
  document.getElementById("typedText").innerHTML = "";
  document.getElementById("finalMessage").classList.remove("show-final");
  document.getElementById("finalImages").classList.remove("show-images");
  i = 0;
}
</script>

</body>
</html>
